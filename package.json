{
  "name": "ai-manufacturing-event-registration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,blue \"vite --host 0.0.0.0\" \"cross-env DEV_API_ONLY=1 PORT=5178 PUBLIC_URL=http://localhost:5173 tsx watch server/index.ts\"",
    "clean": "tsx scripts/clean.ts",
    "build": "npm run clean && tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node server-dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "hash-password": "tsx scripts/hash-password.ts",
    "generate-secrets": "tsx scripts/generate-secrets.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.6.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}