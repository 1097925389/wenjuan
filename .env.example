# Node 服务监听端口
PORT=3000

# 必须填写二维码实际指向的完整公网地址，不要在末尾添加斜杠
PUBLIC_URL=http://YOUR_SERVER_IP:3000

# 报名数据目录必须位于网站公开目录之外，并在 1Panel 中持久化/备份
DATA_DIR=./data

# 共享导出账号。生产密码不要明文写入本文件。
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=请运行_npm_run_hash-password_并按提示输入密码生成

# 运行 npm run generate-secrets 后分别填写，或使用等价安全随机值
DATA_ENCRYPTION_KEY=请填写32字节随机密钥的Base64值
SESSION_SECRET=请填写至少32个字符的随机字符串

# 通过 1Panel 反向代理启用 HTTPS 后设为 1；直接 IP:端口访问保持 0
TRUST_PROXY=0
